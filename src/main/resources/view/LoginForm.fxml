<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.LoginFormController">
   <children>
      <Label layoutX="185.0" layoutY="14.0" text="Login to your account">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <Button fx:id="btnLogin" layoutX="223.0" layoutY="266.0" mnemonicParsing="false" onAction="#loginOnAction" prefHeight="26.0" prefWidth="94.0" text="Login" />
      <Label layoutX="197.0" layoutY="322.0" text="Don't have an account?" />
      <TextField fx:id="txtUserName" alignment="CENTER" layoutX="195.0" layoutY="91.0" onAction="#userNameOnAction" promptText="User Name" />
      <PasswordField fx:id="password" alignment="CENTER" layoutX="196.0" layoutY="155.0" onAction="#passwordOnAction" promptText="Password" />
      <Button fx:id="btnRegister" layoutX="323.0" layoutY="318.0" mnemonicParsing="false" onAction="#registerOnAction" text="Register" />
      <CheckBox fx:id="checkBoxLog" layoutX="135.0" layoutY="232.0" mnemonicParsing="false" onAction="#checkBoxLoginOnAction" text="Remember me" />
      <Button fx:id="btnForgotPassword" layoutX="345.0" layoutY="228.0" mnemonicParsing="false" onAction="#forgotPasswordOnAction" text="Forgot Password?" />
   </children>
</AnchorPane>
