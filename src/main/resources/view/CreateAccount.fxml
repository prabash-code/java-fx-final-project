<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.CreateAccountFormController">
   <children>
      <Label layoutX="226.0" layoutY="29.0" text="Create Account ">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <Label layoutX="128.0" layoutY="96.0" text="Enter Name">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="128.0" layoutY="154.0" text="Email" />
      <Label layoutX="128.0" layoutY="218.0" text="Password" />
      <TextField fx:id="txtUserName" layoutX="129.0" layoutY="120.0" onAction="#userNameOnAction" promptText="Enter your name" />
      <TextField fx:id="txtEmail" layoutX="130.0" layoutY="179.0" onAction="#emailOnAction" prefHeight="26.0" prefWidth="297.0" promptText="Enter your email" />
      <PasswordField fx:id="txtPassword" layoutX="129.0" layoutY="243.0" onAction="#passwordOnAction" promptText="Enter Password" />
      <Button fx:id="btnCreateAccount" layoutX="419.0" layoutY="340.0" mnemonicParsing="false" onAction="#createAccountOnAction" prefHeight="26.0" prefWidth="134.0" text="Create my account " />
   </children>
</AnchorPane>
