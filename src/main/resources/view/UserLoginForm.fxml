<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="360.0" prefWidth="332.0" style="-fx-border-radius: 8px;" styleClass="userLoging-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.UserLoginFormController">
   <children>
      <Label layoutX="92.0" layoutY="32.0" styleClass="userLoging-label" text="Login Form">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <Button fx:id="btnLogin" layoutX="112.0" layoutY="202.0" mnemonicParsing="false" onAction="#loginOnAction" prefHeight="26.0" prefWidth="94.0" styleClass="userLogingLog-btn" text="Login" />
      <Label layoutX="41.0" layoutY="271.0" text="Don't have an account?" textFill="#948989" />
      <Button fx:id="btnRegister" layoutX="167.0" layoutY="269.0" mnemonicParsing="false" onAction="#registerOnAction" styleClass="userRegister-btn" text="Register" />
      <Button fx:id="backToHomebtn" layoutX="214.0" layoutY="310.0" mnemonicParsing="false" onAction="#backToHomeBtnOnAction" prefHeight="36.0" prefWidth="104.0" styleClass="userLogingBackToHome-btn" text="Back to Home" />
      <TextField fx:id="txtEmailBtn" alignment="CENTER" layoutX="85.0" layoutY="92.0" promptText="Email" />
      <PasswordField fx:id="txtPasswordBtn" alignment="CENTER" layoutX="85.0" layoutY="132.0" promptText="Password" />
   </children>
</AnchorPane>
